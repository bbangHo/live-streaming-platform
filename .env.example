# 선택 사항. 없어도 `docker compose up -d`로 PC 한 대에서 송출·시청이 된다.
# 쓰려면: cp .env.example .env  (.env는 커밋 금지)

# 페이지 포트 (기본 8000)
WEB_PORT=8000

# WebRTC가 알려 줄 주소. 같은 PC에서만 쓰면 127.0.0.1,
# 휴대폰 등 다른 기기에서 송출하면 이 PC의 LAN IP (예: 192.168.0.10)
PUBLIC_HOST=127.0.0.1

# --profile https 일 때 인증서를 낼 이름. localhost / LAN IP(사설 인증서) / 공인 도메인(Let's Encrypt)
DOMAIN=localhost

# ── 백엔드 (Spring Boot) / DB ──
# API 포트 (기본 8080)
API_PORT=8080

# PostgreSQL 자격증명. 없으면 compose 기본값(로컬 전용)으로 뜬다. 배포 시 반드시 바꾼다
POSTGRES_DB=livestream
POSTGRES_USER=livestream
POSTGRES_PASSWORD=change-me

# access token 서명 키 (HS256, 32자 이상). 비우면 기동마다 임의 키 → 재시작하면 다시 로그인
# 생성 예: openssl rand -base64 48
JWT_SECRET=
