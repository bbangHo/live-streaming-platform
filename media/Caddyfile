# compose.yml의 https 프로필용. {$DOMAIN}이 공인 도메인이면 Let's Encrypt 자동 발급, localhost·IP면 Caddy 사설 인증서
{$DOMAIN} {
	encode gzip

	# WHIP 송출 / WHEP 시청 (WebRTC 시그널링)
	@webrtc path_regexp ^/live/[^/]+/(whip|whep)(/.*)?$
	handle @webrtc {
		reverse_proxy mediamtx:8889
	}

	# 내부 전용(MediaMTX → 백엔드 송출 인증). 밖에서는 막는다
	handle /api/internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy backend:8080
	}
	# 녹화 재생 (MediaMTX playback 서버)
	handle_path /playback/* {
		reverse_proxy mediamtx:9996
	}

	# HLS 재생목록·세그먼트
	handle /live/* {
		reverse_proxy mediamtx:8888
	}

	handle {
		root * /srv/web
		file_server
	}
}
